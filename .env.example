# Copy to .env and change these before going live.
ADMIN_PASSWORD=change-me-to-something-long
# Keeps admin logged in across server restarts. Any long random string.
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
# The live site's address, e.g. https://enhcept.com. Read at build time for the share-preview image link.
SITE_URL=http://localhost:3000
# Optional. Where the SQLite file lives (default: storage/enquiries.db). In production, point it at a persistent disk.
# DB_PATH=/data/enquiries.db
